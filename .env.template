# Kopiera till .env på servern (git-ignorerad) och fyll i värdena.

# JWT-secret för admin-sessioner.
# Generera: python3 -c "import secrets; print(secrets.token_hex(64))"
MARKROUNDING_SECRET=

# PBKDF2-hash av admin-lösenordet.
# Generera: uv run markrounding hash-password
# ⚠️ VIKTIGT för docker compose: hashen innehåller $-tecken som compose
# tolkar som variabelreferenser ("variable is not set"-varningar och tom
# hash i containern). Dubbla varje $ till $$ i värdet nedan:
#   pbkdf2$260000$abc...$def...  →  pbkdf2$$260000$$abc...$$def...
# (Gäller bara när compose läser filen; kör du appen nativt ska $ vara enkla.)
MARKROUNDING_ADMIN_PASSWORD_HASH=

# Anubis (PoW-gate): måste matcha det publika hostnamnet, annars
# accepteras inte clearance-cookien.
ANUBIS_COOKIE_DOMAIN=markrounding.bibliotekarien.se
# ANUBIS_DIFFICULTY=4

# Server-side Matomo-tracking (Tracking HTTP API). Lämna tomt för att
# stänga av. Site-id skapas i Matomo-admin på bibstats.
MARKROUNDING_MATOMO_URL=https://bibstats.bibliotekarien.se
MARKROUNDING_MATOMO_SITE_ID=
# token_auth krävs för att besökarens riktiga IP (cip) ska registreras —
# skapa en app-specifik token i Matomo: Administration → Personal → Security.
MARKROUNDING_MATOMO_TOKEN=
